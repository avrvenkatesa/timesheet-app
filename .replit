modules = ["nodejs-20", "web"]
run = "npm run start"

[nix]
channel = "stable-25_05"

[deployment]
run = ["sh", "-c", "npm run start"]

[[ports]]
localPort = 3000
externalPort = 80

[workflows]
runButton = "Start Full App"

[[workflows.workflow]]
name = "Start Full App"
author = 40079800
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run start"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server && npm start"
